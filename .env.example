NEXUS_ENV=development
NEXUS_SERVICE_NAME=nexus-intelligence-cloud
NEXUS_LOG_LEVEL=INFO
NEXUS_API_HOST=127.0.0.1
NEXUS_API_PORT=8000
NEXUS_ALLOWED_ORIGINS=http://localhost:3000

# Model serving remains disabled until the private vLLM endpoint and secret are configured.
NEXUS_GATEWAY_ENABLED=false
NEXUS_GATEWAY_API_KEY=
NEXUS_VLLM_BASE_URL=http://127.0.0.1:8001
NEXUS_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
NEXUS_MODEL_REQUEST_TIMEOUT=90
NEXUS_MAX_CONCURRENT_GENERATIONS=4
NEXUS_GATEWAY_QUEUE_TIMEOUT=5
